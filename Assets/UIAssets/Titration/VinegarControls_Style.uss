/* --- MAIN PANEL --- */
.titration-panel {
    position: absolute;
    left: 3%;
    top: 15%;
    bottom: 15%;
    width: 140px;
    background-color: rgba(20, 25, 35, 0.85);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    align-items: center;
    padding: 20px 15px;
    justify-content: space-between;
}

/* --- HEADERS & READOUTS --- */
.panel-header {
    color: #93c5fd;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

.readout-box {
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(147, 197, 253, 0.25);
    padding: 12px 5px;
    width: 100%;
    align-items: center;
    margin-bottom: 15px;
}

.volume-label {
    color: #ffffff;
    font-size: 24px;
    -unity-font-style: bold;
}

.unit-label {
    color: #93c5fd;
    font-size: 10px;
    -unity-font-style: bold;
    margin-top: 2px;
}

/* --- THE SLIDER CONTAINER --- */
.slider-container {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    margin-bottom: 15px;
}

/* --- OVERRIDING UNITY'S DEFAULT SLIDER --- */
#burette-slider {
    flex-grow: 1;
    width: 40px;
}

/* The vertical track/groove */
#burette-slider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.7);
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-radius: 6px;
    width: 8px;
    margin-left: 16px; 
}

/* The draggable handle */
#burette-slider .unity-base-slider__dragger {
    background-color: #93c5fd;
    border-color: #ffffff;
    border-width: 2px;
    border-radius: 50%;
    width: 26px;
    height: 26px;
    margin-left: 7px;
    transition-duration: 0.15s;
}

#burette-slider .unity-base-slider__dragger:hover {
    background-color: #ffffff;
    scale: 1.15 1.15;
    border-color: #93c5fd;
}

#burette-slider .unity-base-slider__dragger:active {
    background-color: #60a5fa;
    scale: 0.9 0.9;
}

/* --- STATUS BADGE --- */
.valve-status {
    color: #e2e8f0;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: rgba(147, 197, 253, 0.15);
    padding: 6px 10px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(147, 197, 253, 0.4);
    -unity-text-align: middle-center;
}

/* --- NEW: RESET BURETTE BUTTON --- */
.reset-burette-btn {
    margin-top: 15px;
    background-color: rgba(147, 197, 253, 0.15); /* Sleek translucent blue */
    border-color: #93c5fd; /* Glowing cyan edge */
    border-width: 1px;
    border-radius: 8px;
    color: #93c5fd; /* Cyan text */
    font-size: 12px;
    -unity-font-style: bold;
    padding: 10px 10px; /* Slightly taller for easier tapping */
    width: 100%;
    transition-duration: 0.15s;
    
    /* Forces Unity to drop its default ugly button graphics */
    background-image: none; 
}

/* Hover effect for PC users */
.reset-burette-btn:hover {
    background-color: rgba(147, 197, 253, 0.3);
}

/* Click effect */
.reset-burette-btn:active {
    background-color: #93c5fd;
    color: #1e293b; /* Dark text when tapped */
    scale: 0.95 0.95;
}

/* ========================================= */
/* --- NEW: TOP INFO DASHBOARD STYLES --- */
/* ========================================= */

.info-dashboard {
    position: absolute;
    top: 25px;
    left: 50%;
    translate: -50% 0; /* Magically perfectly centers it horizontally */
    flex-direction: row; /* Aligns the 3 sections left-to-right */
    background-color: rgba(20, 25, 35, 0.85); /* Matches the side panel */
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(147, 197, 253, 0.3);
    padding: 12px 20px;
    align-items: center;
    justify-content: space-between;
}

.info-section {
    flex-direction: column;
    align-items: center;
    padding-left: 20px;
    padding-right: 20px;
}

.info-header {
    color: #93c5fd; /* Cyan title */
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    letter-spacing: 1px;
}

.info-text {
    color: #e2e8f0;
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 2px;
}

.equation-text {
    color: #ffffff;
    font-size: 16px;
}

/* Color Coding to match the 3D chemistry */
.data-base { color: #fde047; } /* Yellow */
.data-acid { color: #fca5a5; } /* Light Red */
.color-yellow { color: #fde047; }
.color-red { color: #fca5a5; }

/* The thin dividing lines between sections */
.vertical-divider {
    width: 1px;
    height: 35px;
    background-color: rgba(147, 197, 253, 0.2);
}

/* Color Coding to match the 3D chemistry */
.color-pink { color: #f472b6; } /* Bright Pink */
.color-colorless { color: #e2e8f0; } /* Light Slate / Clear */