<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Assets/UIAssets/HomeMenuStyles.uss?fileID=7433441132597879392&amp;guid=4faad052a43c3294bbe09b3e2850c006&amp;type=3#HomeMenuStyles"/>
    <ui:VisualElement class="main-container">
        <ui:VisualElement class="top-nav">
            <ui:Button name="btn-back" text="←" class="back-btn"/>
            <ui:VisualElement class="title-container">
                <ui:Label text="🧪" class="title-icon"/>
                <ui:Label text="EXPERIMENTS" class="main-title"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView mode="Horizontal" class="experiment-scrollview">
            <ui:VisualElement class="experiment-card">
                <ui:VisualElement class="card-icon-area">
                    <ui:Label text="🔥" class="card-icon"/>
                </ui:VisualElement>
                <ui:Label text="Flame Test" class="card-title"/>
                <ui:Button name="btn-flame" text="PLAY" class="play-btn"/>
            </ui:VisualElement>
            <ui:VisualElement class="experiment-card">
                <ui:VisualElement class="card-icon-area">
                    <ui:Label text="🪨" class="card-icon"/>
                </ui:VisualElement>
                <ui:Label text="Basic Radical Test For Lead" class="card-title"/>
                <ui:Button name="btn-lead" text="PLAY" class="play-btn"/>
            </ui:VisualElement>
            <ui:VisualElement class="experiment-card">
                <ui:VisualElement class="card-icon-area">
                    <ui:Label text="🥉" class="card-icon"/>
                </ui:VisualElement>
                <ui:Label text="Basic Radical Test For Copper" class="card-title"/>
                <ui:Button name="btn-copper" text="PLAY" class="play-btn"/>
            </ui:VisualElement>
            <ui:VisualElement class="experiment-card">
                <ui:VisualElement class="card-icon-area">
                    <ui:Label text="🧲" class="card-icon"/>
                </ui:VisualElement>
                <ui:Label text="Basic Radical Test For Ferrous" class="card-title"/>
                <ui:Button name="btn-ferrous" text="PLAY" class="play-btn"/>
            </ui:VisualElement>
            <ui:VisualElement class="experiment-card">
                <ui:VisualElement class="card-icon-area">
                    <ui:Label text="💧" class="card-icon"/>
                </ui:VisualElement>
                <ui:Label text="Analysis of Vinegar Acidity" class="card-title"/>
                <ui:Button name="btn-vinegar" text="PLAY" class="play-btn"/>
            </ui:VisualElement>
            <ui:VisualElement class="experiment-card">
                <ui:VisualElement class="card-icon-area">
                    <ui:Label text="⚗️" class="card-icon"/>
                </ui:VisualElement>
                <ui:Label text="Titration (HCl + NaOH)" class="card-title"/>
                <ui:Button name="btn-titration" text="PLAY" class="play-btn"/>
            </ui:VisualElement>
            <!-- NEW PHYSICS EXPERIMENTS ADDED BELOW -->
            <ui:VisualElement class="experiment-card">
                <ui:VisualElement class="card-icon-area">
                    <ui:Label text="⚡" class="card-icon"/>
                </ui:VisualElement>
                <ui:Label text="Ohm's Law" class="card-title"/>
                <ui:Button name="btn-ohm" text="PLAY" class="play-btn"/>
            </ui:VisualElement>
            <ui:VisualElement class="experiment-card">
                <ui:VisualElement class="card-icon-area">
                    <ui:Label text="🔋" class="card-icon"/>
                </ui:VisualElement>
                <ui:Label text="Kirchhoff's Voltage Law" class="card-title"/>
                <ui:Button name="btn-kirchhoff-voltage" text="PLAY" class="play-btn"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>