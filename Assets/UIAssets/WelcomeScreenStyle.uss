.screen-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.85); /* Dark background to focus on instructions */
}

.welcome-panel {
    background-color: rgba(15, 23, 42, 0.95); 
    border-radius: 16px;
    padding: 30px;
    width: 450px; 
    border-width: 2px;
    border-color: rgba(56, 189, 248, 0.6); 
    flex-direction: column;
    align-items: center; 
}

.title-text {
    font-size: 20px;
    color: #e0f2fe; 
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 20px;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: #38bdf8; 
}

.instruction-box {
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(56, 189, 248, 0.3);
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 25px;
    width: 100%;
}

.instruction-text {
    font-size: 15px;
    color: #bae6fd; 
    margin-bottom: 8px;
    white-space: normal;
}

.primary-button {
    background-color: rgba(0, 0, 0, 0.4); 
    color: #38bdf8; 
    font-size: 16px;
    -unity-font-style: bold;
    padding: 12px 50px;
    border-radius: 8px;
    border-width: 2px;
    border-color: #38bdf8; 
    transition-property: background-color, color, scale;
    transition-duration: 0.15s;
}

.primary-button:active {
    background-color: #38bdf8; 
    color: #0f172a; 
    scale: 0.95 0.95; 
}