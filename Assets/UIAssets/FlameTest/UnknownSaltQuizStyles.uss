.quiz-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
    display: none;
}

.quiz-container {
    width: 60%;
    max-width: 650px;
    justify-content: center;
    align-items: center;
}

.quiz-panel {
    width: 100%;
    background-color: rgb(15, 25, 35);
    border-radius: 15px;
    border-width: 2px;
    border-color: rgba(61, 227, 181, 0.4);
    padding: 30px;
}

.panel-header {
    color: rgb(120, 210, 190);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.challenge-desc {
    color: rgb(220, 220, 220);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 30px;
    -unity-text-align: middle-center;
}

.input-field {
    margin-bottom: 15px;
}

.input-field > .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: rgb(80, 120, 180);
    border-radius: 10px;
    color: white;
    font-size: 18px;
    padding: 15px;
}

.feedback-label {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 15px;
    height: 25px;
}

.action-btn {
    background-color: rgba(20, 40, 60, 0.8);
    border-width: 2px;
    border-color: rgb(80, 140, 200);
    border-radius: 25px;
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    padding: 15px;
    transition-duration: 0.2s;
}

.action-btn:hover {
    background-color: rgb(40, 80, 120);
}

.submit-btn {
    width: 50%;
    align-self: center;
}