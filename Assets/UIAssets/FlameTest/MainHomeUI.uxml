<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Assets/UIAssets/FlameTest/MainHomeStyles.uss?fileID=7433441132597879392&amp;guid=a1b48df383b5e6849b4f98d303786c00&amp;type=3#MainHomeStyles"/>
    <ui:VisualElement class="main-container">
        <ui:VisualElement class="left-container">
            <ui:VisualElement name="left-panel" class="left-panel hidden-start-left">
                <ui:Label name="vlab-title" text="VLab AR" class="brand-title"/>
                <ui:Label text="Explore science in real life" class="brand-subtitle"/>
                <ui:Button name="btn-about" text="About Us" class="about-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="right-panel">
            <ui:VisualElement name="card-chemistry" class="glass-card border-cyan hidden-start-right">
                <ui:VisualElement class="icon-circle">
                    <ui:Label text="🧪" class="emoji-icon"/>
                </ui:VisualElement>
                <ui:Label text="Experiments" class="card-title"/>
                <ui:Button name="btn-chemistry" text="Explore" class="enter-btn bg-cyan"/>
            </ui:VisualElement>
            <ui:VisualElement name="card-physics" class="glass-card border-purple hidden-start-right" style="transition-delay: 0.1s;">
                <ui:VisualElement class="icon-circle">
                    <ui:Label text="⚛️" class="emoji-icon"/>
                </ui:VisualElement>
                <ui:Label text="Explorations" class="card-title"/>
                <ui:Button name="btn-physics" text="Explore" class="enter-btn bg-purple"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="btn-info" text="i" class="info-btn hidden-start-top" />
        <ui:Button name="btn-exit" text="" class="exit-btn hidden-start-top" />
    </ui:VisualElement>
</ui:UXML>
