.right-panel {
    width: 55%;
    height: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.glass-card {
    width: 280px;
    height: 400px;
    background-color: rgba(20, 25, 35, 0.85);
    border-radius: 25px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    margin-left: 20px;
    margin-right: 20px;
    padding: 30px;
    align-items: center;
    justify-content: space-between;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-bounce;
}

.glass-card:hover {
    scale: 1.05;
    background-color: rgba(25, 35, 50, 0.95);
    translate: 0 -10px;
}

.icon-circle {
    width: 120px;
    height: 120px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 60px;
    justify-content: center;
    align-items: center;
    margin-top: 10px;
    transition-duration: 0.3s;
}

.emoji-icon {
    font-size: 65px;
    transition-duration: 0.3s;
}

.glass-card:hover .emoji-icon {
    scale: 1.2;
}

.card-title {
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 15px;
    flex-grow: 1;
}

.enter-btn {
    width: 90%;
    height: 55px;
    border-radius: 27px;
    border-width: 0;
    color: rgb(15, 20, 30);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    transition-duration: 0.2s;
}

.enter-btn:hover {
    scale: 1.08;
    color: white;
}

.glass-card.border-cyan:hover {
    border-color: rgb(61, 227, 181);
    box-shadow: 0 0 20px rgba(61, 227, 181, 0.2);
}

.bg-cyan {
    background-color: rgb(61, 227, 181);
}

.glass-card.border-cyan:hover .icon-circle {
    background-color: rgba(61, 227, 181, 0.15);
}

.glass-card.border-purple:hover {
    border-color: rgb(180, 100, 255);
    box-shadow: 0 0 20px rgba(180, 100, 255, 0.2);
}

.bg-purple {
    background-color: rgb(180, 100, 255);
}

.glass-card.border-purple:hover .icon-circle {
    background-color: rgba(180, 100, 255, 0.15);
}

.hidden-start-left {
    translate: -150px 0;
    opacity: 0;
}

.hidden-start-right {
    translate: 150px 0;
    opacity: 0;
}

.hidden-start-top {
    translate: 0 -100px;
    opacity: 0;
}
