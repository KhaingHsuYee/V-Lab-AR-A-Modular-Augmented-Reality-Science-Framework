/* Keeps the menu pinned to the bottom of the phone screen */
.full-screen-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: flex-end; 
    align-items: center;
    padding-bottom: 40px; 
}

/* The Holographic Bounded Menu Box[cite: 3] */
.bottom-menu-panel {
    background-color: rgba(15, 23, 42, 0.95); 
    border-radius: 16px;
    padding: 20px;
    width: 90%; 
    max-width: 500px;
    
    border-width: 2px;
    border-color: rgba(56, 189, 248, 0.6); 
    
    flex-direction: column;
    align-items: center;
}

/* The Glowing Title[cite: 3] */
.menu-title {
    font-size: 18px;
    color: #e0f2fe; 
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 15px;
    
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: #38bdf8; 
}

/* Keeps the buttons in a neat, wrapping grid */
.button-row {
    flex-direction: row;
    flex-wrap: wrap; 
    justify-content: center;
    width: 100%;
}

/* Primary Holographic Button Style Adapted for a Grid[cite: 3] */
.device-button {
    background-color: rgba(0, 0, 0, 0.4); 
    color: #38bdf8; 
    font-size: 14px;
    -unity-font-style: bold;
    
    padding: 12px 15px;
    margin: 5px;
    border-radius: 8px;
    border-width: 2px;
    border-color: #38bdf8; 
    
    /* Makes the buttons share the row space equally */
    flex-grow: 1; 
    min-width: 120px; 
    
    transition-property: background-color, color, scale;
    transition-duration: 0.15s;
}

/* Button Click Animation[cite: 3] */
.device-button:active {
    background-color: #38bdf8; 
    color: #0f172a; 
    scale: 0.95 0.95; 
}