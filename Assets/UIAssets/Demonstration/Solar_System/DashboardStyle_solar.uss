.dashboard-container {
    width: 400px;
    background-color: rgba(15, 25, 40, 0.85);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(100, 200, 255, 0.5);
    padding: 20px;
    align-items: stretch;
    justify-content: flex-start;
}

.header-section {
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    padding-bottom: 10px;
    margin-bottom: 15px;
    align-items: center;
}

.title-text {
    font-size: 42px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin: 0;
}

.subtitle-text {
    font-size: 18px;
    color: rgb(150, 200, 255);
    margin: 0;
}

.data-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

.data-label {
    font-size: 18px;
    color: rgb(200, 200, 200);
}

.data-value {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}