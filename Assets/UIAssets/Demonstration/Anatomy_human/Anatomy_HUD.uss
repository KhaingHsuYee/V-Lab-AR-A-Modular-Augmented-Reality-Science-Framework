.screen-root {
    width: 100%;
    height: 100%;
    position: absolute;
    justify-content: flex-end;
}

.info-panel {
    position: absolute;
    left: 20px;
    top: 40px;
    bottom: 250px;
    width: 350px;
    max-width: 350px;
    right: auto;
    align-self: flex-start;
    background-color: rgba(20, 25, 35, 0.95);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    display: none;
}

.info-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(0, 204, 255);
    padding: 15px 20px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    overflow: hidden;
}

.info-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    flex-shrink: 1;
    white-space: normal;
}

.control-btn,
.close-info-btn {
    flex-shrink: 0;
}

.close-info-btn {
    background-color: transparent;
    border-width: 0;
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-left: 5px;
}

.control-btn {
    background-color: rgb(255, 170, 0);
    color: white;
    border-radius: 8px;
    border-width: 0;
    font-size: 16px;
    width: 30px;
    height: 30px;
    margin-right: 10px;
    -unity-font-style: bold;
}

.control-btn:hover {
    background-color: rgb(255, 190, 50);
}

.info-scrollview {
    flex-grow: 1;
    padding: 15px 20px;
}

.section-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(0, 204, 255);
    margin-top: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    padding-bottom: 4px;
}

.body-text {
    font-size: 13px;
    color: rgb(220, 220, 220);
    white-space: normal;
}

.overview-margin {
    margin-bottom: 20px;
    margin-top: 5px;
}

.organ-card {
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 10px;
    border-left-width: 4px;
    border-left-color: rgb(0, 204, 255);
}

.organ-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 4px;
}

.toggle-menu-btn {
    width: 200px;
    height: 50px;
    align-self: center;
    margin-bottom: 20px;
    border-radius: 25px;
    -unity-font-style: bold;
    background-color: rgba(0, 204, 255, 0.8);
    color: white;
    border-width: 0;
}

#bottom-sheet-panel {
    position: absolute;
    bottom: 20px;
    align-self: center;
    width: 90%;
    max-width: 600px;
    background-color: rgba(15, 20, 30, 0.95);
    border-radius: 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 20px;
    translate: 0 150%;
    transition-property: translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.sheet-title {
    color: rgb(147, 197, 253);
    font-size: 18px;
    -unity-font-style: bold;
    align-self: center;
    margin-bottom: 15px;
}

#bottom-sheet-panel .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

#bottom-sheet-panel Button {
    background-color: rgba(20, 150, 255, 0.15);
    color: white;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(20, 150, 255, 0.5);
    padding: 12px 10px;
    margin: 6px;
    -unity-font-style: bold;
    font-size: 14px;
    min-width: 140px;
    transition-duration: 0.2s;
}

#bottom-sheet-panel Button:hover {
    background-color: rgba(20, 150, 255, 0.6);
    scale: 1.05;
}

#bottom-sheet-panel #btn-close-menu {
    background-color: rgba(220, 50, 50, 0.9);
    border-width: 0;
    margin-top: 15px;
    width: 250px;
    align-self: center;
    border-radius: 16px;
}

.unity-scroll-view__vertical-scroller {
    width: 8px;
    margin-right: 2px;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    width: 8px;
    left: 0;
    border-width: 0;
}

.unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.8);
}