.main-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(15, 20, 30);
    background-image: url("project://database/Assets/Assets/Images/lab_bg_1.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

/* Updated Back Button */
.back-btn {
    position: absolute;
    top: 35px;
    left: 40px;
    width: 50px;
    height: 50px;
    border-radius: 25px; /* Perfect circle */
    background-color: rgb(15, 20, 30); /* Dark solid background */
    border-color: rgb(61, 227, 181); /* Cyan border */
    border-width: 2px;
    color: white; /* White arrow */
    font-size: 28px; /* Slightly larger text for the thin arrow */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
    padding-bottom: 2px; /* Optically centers the arrow */
}

.back-btn:hover {
    background-color: rgb(61, 227, 181);
    color: rgb(15, 20, 30); /* Dark arrow on hover */
    scale: 1.1;
    box-shadow: 0 0 15px rgba(61, 227, 181, 0.4);
}

.glass-card {
    width: 1100px;
    background-color: rgba(15, 20, 30, 0.9);
    border-radius: 30px;
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 2px;
    padding: 50px;
    align-items: center;
    transition-duration: 0.8s;
    transition-timing-function: ease-out-back;
}

.layout-vertical {
    flex-direction: column;
}

.header-container {
    align-items: center;
    margin-bottom: 40px;
}

.brand-title {
    font-size: 50px;
    color: white;
    -unity-font-style: bold;
    letter-spacing: 4px;
    text-shadow: 0 0 15px rgba(255, 80, 80, 0.6);
    margin-bottom: 10px;
    transition-duration: 1s;
}

.brand-title-pulse {
    text-shadow: 0 0 35px rgba(255, 80, 80, 1);
    scale: 1.02;
}

.about-desc {
    font-size: 16px;
    color: rgb(200, 220, 240);
    white-space: normal;
}

.text-center {
    -unity-text-align: middle-center;
}

/* Three-Column Layout */
.warning-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.warning-box {
    width: 31%;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 20px;
    border-width: 2px;
    padding: 30px 20px;
    align-items: center;
    transition-duration: 0.3s;
}

.warning-box:hover {
    background-color: rgba(20, 25, 35, 0.95);
    translate: 0 -10px;
}

.border-cyan { border-color: rgba(61, 227, 181, 0.4); }
.border-cyan:hover { border-color: rgb(61, 227, 181); }

.border-purple { border-color: rgba(180, 100, 255, 0.4); }
.border-purple:hover { border-color: rgb(180, 100, 255); }

.border-pink { border-color: rgba(255, 100, 150, 0.4); }
.border-pink:hover { border-color: rgb(255, 100, 150); }

.warning-icon {
    font-size: 45px;
    margin-bottom: 15px;
}

.warning-header {
    font-size: 20px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 15px;
    -unity-text-align: middle-center;
}

.warning-text {
    font-size: 14px;
    color: rgb(180, 200, 220);
    white-space: normal;
    -unity-text-align: middle-center;
    line-height: 22px;
}

/* Animations */
.hidden-start-top { translate: 0 -100px; opacity: 0; }
.hidden-start-bottom { translate: 0 100px; opacity: 0; }