
/* Main Dashboard Wrapper */
.dashboard-root {
    width: 650px; /* Increased from 480px to make the panel longer */
    height: 380px;
    background-color: rgba(20, 25, 35, 0.95);
    border-radius: 15px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 20px;
    flex-direction: column;
}

/* Mask to hide pages that are off-screen */
.swipe-mask {
    flex-grow: 1;
    overflow: hidden; 
    width: 100%;
}

/* The long container holding all 8 pages (800% width) */
.sliding-container {
    height: 100%;
    width: 800%; 
    flex-direction: row;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-circ;
}

/* Individual Page setup (100 / 8 = 12.5%) */
.page {
    width: 12.5%; 
    height: 100%;
    padding: 10px;
    flex-direction: column;
}

/* --- Typography --- */
.page-title {
    color: white;
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 5px;
    border-bottom-width: 2px;
    padding-bottom: 5px;
}

.section-header {
    color: #4CAF50;
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 15px;
    margin-bottom: 5px;
}

.body-text {
    color: #E0E0E0;
    font-size: 14px;
    white-space: normal;
}

/* --- Color Legend Specifics --- */
.legend-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.color-box {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    margin-right: 15px;
}

/* Group Colors */
.bg-alkali { background-color: rgba(41, 128, 185, 1); border-bottom-color: rgba(41, 128, 185, 1); }
.bg-transition { background-color: rgba(46, 204, 113, 1); border-bottom-color: rgba(46, 204, 113, 1); }
.bg-halogen { background-color: rgba(241, 196, 15, 1); border-bottom-color: rgba(241, 196, 15, 1); }
.bg-noble { background-color: rgba(231, 76, 60, 1); border-bottom-color: rgba(231, 76, 60, 1); }
.bg-lanthanide { background-color: rgba(127, 140, 141, 1); border-bottom-color: rgba(127, 140, 141, 1); }
.bg-actinide { background-color: rgba(142, 68, 173, 1); border-bottom-color: rgba(142, 68, 173, 1); }
.bg-nonmetal { background-color: rgba(230, 126, 34, 1); border-bottom-color: rgba(230, 126, 34, 1); }

/* Swipe Instructions */
.swipe-hint {
    color: rgba(255, 255, 255, 0.4);
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-top: 10px;
    -unity-font-style: italic;
}

/* --- Audio Button --- */
.audio-btn {
    background-color: rgba(255, 255, 255, 0.15);
    color: white;
    border-radius: 8px;
    padding: 6px 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    align-self: flex-start; /* Keeps the button from stretching across the screen */
    margin-bottom: 10px;
    margin-top: 5px;
    font-size: 14px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.audio-btn:hover {
    background-color: rgba(76, 175, 80, 0.8); /* Glows green when hovered/tapped */
    border-color: #4CAF50;
    scale: 1.05;
}