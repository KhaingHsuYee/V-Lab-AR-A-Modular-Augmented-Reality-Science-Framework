/* --- MAIN HUD LAYOUT --- */
.hud-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    picking-mode: ignore; /*[cite: 2] */
}

.bottom-bar {
    position: absolute;
    bottom: 20px;
    left: 2%;
    right: 110px; 
    height: 40px;
    background-color: rgba(30, 30, 30, 0.85); 
    border-radius: 12px; /* Soft rectangle[cite: 2] */
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
    picking-mode: ignore; /*[cite: 2] */
}

.status-label {
    color: rgb(224, 242, 254);
    font-size: 16px;
    -unity-font-style: bold; /*[cite: 2] */
}

.right-toolbar {
    position: absolute;
    right: 15px;
    top: 50%;
    translate: 0 -50%;
    width: 70px;
    background-color: rgba(20, 25, 35, 0.65);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    flex-direction: column;
    align-items: center;
    padding-top: 15px;
    padding-bottom: 15px; /*[cite: 2] */
}

.icon-btn {
    width: 45px;
    height: 45px;
    background-color: transparent; /* Inside completely invisible[cite: 2] */
    border-width: 0; /* Removes border[cite: 2] */
    margin-top: 12px;
    margin-bottom: 12px;
    transition-duration: 0.15s;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #93c5fd; /*[cite: 2] */
}

.icon-btn:active {
    scale: 0.85 0.85;
    -unity-background-image-tint-color: #ffffff; /*[cite: 2] */
}

.floating-add-button {
    position: absolute;
    right: 100px;
    bottom: 50px;
    width: 140px;
    height: 55px;
    background-color: rgba(147, 197, 253, 0.2);
    border-color: #93c5fd;
    border-width: 2px;
    border-radius: 12px;
    color: #93c5fd;
    font-size: 18px;
    -unity-font-style: bold; /*[cite: 2] */
}

/* --- OVERLAYS --- */
.popup-overlay, .overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85); /* Darker dimming effect[cite: 2, 3] */
    justify-content: center;
    align-items: center;
    display: none; /* Default hidden state[cite: 3] */
}

.popup-overlay {
    display: flex; /* Main HUD overlay display rule override[cite: 2] */
    picking-mode: auto; /*[cite: 2] */
}

/* --- POPUP BOX & TEXT --- */
.popup-box {
    width: 500px; /* Increased width[cite: 2] */
    min-height: 250px; /* Forces taller box[cite: 2] */
    background-color: rgba(20, 25, 35, 0.95);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 40px; /* More breathing room[cite: 2] */
    align-items: center;
    justify-content: space-between; /*[cite: 2] */
}

.popup-title, .title {
    color: #93c5fd; 
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 12px; /*[cite: 2, 3] */
}

.title-success {
    color: rgb(120, 255, 120); /* Green text for success[cite: 3] */
}

.popup-message, .message {
    color: #e2e8f0;
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 25px; /*[cite: 2, 3] */
}

/* --- BUTTON CONTAINERS & BUTTONS --- */
.popup-button-container, .button-container {
    flex-direction: row;
    justify-content: space-between;
    width: 100%; /*[cite: 2, 3] */
}

.popup-btn {
    width: 47%;
    height: 42px;
    border-radius: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    transition-duration: 0.15s;
    border-width: 1px;
    background-color: transparent;
    color: white; /*[cite: 2, 3] */
}

.popup-btn:hover {
    background-color: rgba(160, 200, 255, 0.2); /*[cite: 3] */
}

.popup-btn-secondary {
    border-color: rgba(255, 255, 255, 0.3);
    color: #e2e8f0; /*[cite: 2] */
}

.popup-btn-secondary:active {
    background-color: rgba(255, 255, 255, 0.1);
    scale: 0.95 0.95; /*[cite: 2] */
}

.popup-btn-primary {
    background-color: rgba(147, 197, 253, 0.15);
    border-color: #93c5fd;
    color: #93c5fd; /*[cite: 2] */
}

.popup-btn-primary:active {
    background-color: #93c5fd;
    color: #1e293b;
    scale: 0.95 0.95; /*[cite: 2] */
}

.primary-btn {
    background-color: rgb(160, 200, 255);
    color: rgb(26, 32, 44);
    border-color: rgb(160, 200, 255); /*[cite: 3] */
}

.primary-btn:hover {
    background-color: rgb(200, 230, 255); /*[cite: 3] */
}

.success-btn {
    background-color: rgb(120, 255, 120);
    border-color: rgb(120, 255, 120);
    color: rgb(26, 32, 44); /*[cite: 3] */
}

.success-btn:hover {
    background-color: rgb(160, 255, 160); /*[cite: 3] */
}


/* Style the main bottom container */
#bottom-element-menu {
    position: absolute;
    bottom: 20px;
    left: 5%;
    right: 5%;
    height: 125px; /* Increased to fit the legend row */
    background-color: rgba(20, 25, 35, 0.9);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 10px 15px;
}

/* Force the ScrollView to fill the container */
#element-scroll-view {
    width: 100%;
    height: 100%;
}


/* The new Square Tile design */
.element-btn {
    flex-shrink: 0; /* NEW: Forces buttons to stay full size so the menu scrolls */
    width: 60px;
    height: 60px;
    margin-right: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-radius: 12px;
    font-size: 24px;
    -unity-font-style: bold;
    transition-duration: 0.15s;
}

.element-btn:hover {
    scale: 1.1 1.1;
    background-color: rgba(255, 255, 255, 0.1);
}

.active-element-btn {
    background-color: rgba(255, 255, 255, 0.25);
    scale: 1.1 1.1;
}

#element-scroll-view .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: center; /* Centers buttons to stop vertical overflow */
    height: 100%;        /* Forces container to respect the bounds */
}

/* Sleek Horizontal Scrollbar for Bottom Menu */
#element-scroll-view .unity-scroller--horizontal {
    height: 6px;
    margin-top: 8px;
}

#element-scroll-view .unity-scroller--horizontal .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    border-radius: 3px;
}

#element-scroll-view .unity-scroller--horizontal .unity-base-slider__dragger {
    background-color: rgba(147, 197, 253, 0.4);
    border-radius: 3px;
    border-width: 0;
}

#element-scroll-view .unity-scroller--horizontal .unity-base-slider__dragger:hover {
    background-color: rgba(147, 197, 253, 0.8);
}

#element-scroll-view .unity-scroller--horizontal .unity-scroller__low-button,
#element-scroll-view .unity-scroller--horizontal .unity-scroller__high-button {
    display: none;
}

/* Bulletproof fix: Completely hide the vertical scrollbar in the bottom menu */
#element-scroll-view .unity-scroller--vertical {
    display: none;
    width: 0;
}

/* Beautiful styling for the stubborn vertical scrollbar */
#element-scroll-view .unity-scroller--vertical {
    width: 6px;
    margin-right: 2px;
}

#element-scroll-view .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    border-radius: 3px;
}

#element-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(147, 197, 253, 0.4);
    border-radius: 3px;
    border-width: 0;
}

#element-scroll-view .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(147, 197, 253, 0.8);
}

#element-scroll-view .unity-scroller--vertical .unity-scroller__low-button,
#element-scroll-view .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

/* --- Color Map Legend --- */
.legend-container {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.legend-item {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
    margin-right: 12px;
}

.legend-color {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    margin-right: 6px;
}

.legend-text {
    color: #e2e8f0;
    font-size: 11px;
    -unity-font-style: bold;
}