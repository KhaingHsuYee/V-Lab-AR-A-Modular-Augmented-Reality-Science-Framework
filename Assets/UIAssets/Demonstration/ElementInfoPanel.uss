.main-panel {
    width: 350px;
    height: 70%;
    max-height: 800px;
    background-color: rgba(20, 20, 25, 0.85);
    border-radius: 15px;
    position: absolute;
    top: 50px;
    left: 20px;
    padding: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    color: rgb(240, 240, 240);
}

.header-section {
    flex-direction: row;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    padding-bottom: 15px;
}

.header-left {
    width: 80px;
    justify-content: center;
    align-items: center;
}

.symbol-text {
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(0, 204, 255);
}

.header-right {
    flex-grow: 1;
    justify-content: center;
    padding-left: 10px;
}

.name-text {
    font-size: 24px;
    -unity-font-style: bold;
}

.subtitle-text {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-top: 2px;
}

.category-text {
    font-size: 12px;
    color: rgb(150, 255, 150);
    margin-top: 4px;
    -unity-font-style: italic;
}

.details-scrollview {
    flex-grow: 1;
}

/* Updated section title with separator line */
.section-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(0, 204, 255);
    margin-top: 25px;
    margin-bottom: 10px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
}


.body-text {
    font-size: 13px;
    white-space: normal;
    color: rgb(200, 200, 200);
}

.data-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.data-label {
    font-size: 13px;
    color: rgb(170, 170, 170);
}

.data-value {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
}

.screen-root {
    width: 100%;
    height: 100%;
    position: absolute;
    picking-mode: ignore; /* NEW: Lets clicks pass through the invisible background */
}
/* Top Dashboard Styles */
.top-dashboard {
    position: absolute;
    top: 40px;
    align-self: center;
    flex-direction: row;
    background-color: rgba(20, 20, 25, 0.9);
    border-radius: 20px;
    padding: 10px 30px;
    border-width: 1px;
    border-color: rgba(0, 204, 255, 0.3);
}

.particle-stat {
    align-items: center;
    margin: 0 15px;
}

.particle-label {
    font-size: 12px;
    color: rgb(170, 170, 170);
}

.particle-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(0, 204, 255);
}

.particle-divider {
    width: 1px;
    background-color: rgba(255, 255, 255, 0.2);
    margin: 5px 0;
}

/* Circular dot for the particle legend */
.particle-color {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
}

/* BEAUTIFUL SCROLLBAR */
.unity-scroll-view .unity-scroller--vertical {
    width: 6px;
    margin-left: 5px;
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    border-radius: 3px;
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(0, 204, 255, 0.4);
    border-radius: 3px;
    border-width: 0;
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(0, 204, 255, 0.8);
}

.unity-scroll-view .unity-scroller--vertical .unity-scroller__low-button,
.unity-scroll-view .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

/* New Horizontal Scrollbar Styling */
.unity-scroll-view .unity-scroller--horizontal {
    height: 6px;
    margin-top: 5px;
}

.unity-scroll-view .unity-scroller--horizontal .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    border-radius: 3px;
}

.unity-scroll-view .unity-scroller--horizontal .unity-base-slider__dragger {
    background-color: rgba(0, 204, 255, 0.4);
    border-radius: 3px;
    border-width: 0;
}

.unity-scroll-view .unity-scroller--horizontal .unity-base-slider__dragger:hover {
    background-color: rgba(0, 204, 255, 0.8);
}

.unity-scroll-view .unity-scroller--horizontal .unity-scroller__low-button,
.unity-scroll-view .unity-scroller--horizontal .unity-scroller__high-button {
    display: none;
}