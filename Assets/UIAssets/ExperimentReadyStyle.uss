/* 1. THE HOLOGRAPHIC PANEL */
/* 1. The Full-Screen Dark Overlay */
.screen-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    
    justify-content: center;
    align-items: center;
    
    /* This dims the AR camera view */
    background-color: rgba(0, 0, 0, 0.75); 
}

/* 2. The Bounded Menu Box (The Card) */
.experiment-panel {
    /* A semi-solid dark blue background so the box is clearly visible */
    background-color: rgba(15, 23, 42, 0.95); 
    
    border-radius: 16px;
    padding: 30px;
    width: 380px; 
    position: relative; 
    
    /* The glowing holographic border */
    border-width: 2px;
    border-color: rgba(56, 189, 248, 0.6); 
    
    /* Ensures everything inside stays centered */
    flex-direction: column;
    align-items: center;
}
/* 2. THE GLOWING TITLE */
.title-text {
    font-size: 24px;
    color: #e0f2fe; /* Almost white with a blue tint */
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 5px;
    
    /* Fakes a hologram glow by adding a neon outline */
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: #38bdf8; 
}

/* 3. THE SCANNED SUBTITLE */
.subtitle-text {
    font-size: 16px;
    color: #38bdf8; /* Pure neon blue */
    -unity-text-align: middle-center;
    margin-bottom: 25px;
}

/* 4. INSTRUCTIONS HEADER */
.instructions-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.icon-text {
    font-size: 18px;
    margin-right: 8px;
    /* Optional: If you use a UI Toolkit icon here later, tint it blue */
    color: #38bdf8; 
}

.header-text {
    font-size: 16px;
    color: #bae6fd; /* Soft glowing blue */
    -unity-font-style: bold;
}

/* 5. FLOATING LIST ITEMS */
.instructions-list {
    margin-bottom: 30px;
    margin-left: 5px;
}

.list-item {
    font-size: 15px;
    color: #7dd3fc; /* Muted neon blue */
    margin-bottom: 8px;
    white-space: normal;
}

.button-container {
    align-items: center;
}

/* 6. YOUR HOLOGRAPHIC HELP BUTTON */
.help-button {
    position: absolute;
    bottom: 15px;
    right: 15px;
    width: 28px;
    height: 28px;
    border-radius: 14px; 
    
    /* Transparent with a glowing border */
    background-color: rgba(0, 0, 0, 0.4); 
    color: #38bdf8;
    font-size: 14px;
    -unity-font-style: bold;
    
    border-width: 1.5px;
    border-color: #38bdf8;
    padding: 0;
    
    transition-property: background-color, color, scale;
    transition-duration: 0.15s;
}

.help-button:active {
    background-color: #38bdf8;
    color: #0f172a;
    scale: 0.9 0.9;
}
.primary-button {
    /* Transparent center with a bright neon border */
    background-color: rgba(0, 0, 0, 0.4); 
    color: #38bdf8; /* Bright neon blue text */
    font-size: 16px;
    -unity-font-style: bold;
    padding: 12px 40px;
    border-radius: 8px;
    
    border-width: 2px;
    border-color: #38bdf8; 
    
    transition-property: background-color, color, scale;
    transition-duration: 0.15s;
}

.primary-button:active {
    /* Fill in the background and flip the text color */
    background-color: #38bdf8; 
    color: #0f172a; 
    
    /* A slight physical shrink */
    scale: 0.95 0.95; 
}