<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Assets/UIAssets/BasicRadical/Dashboard.uss?fileID=7433441132597879392&amp;guid=110dd8273f4322d4ba231e7f20963c79&amp;type=3#Dashboard"/>
    <ui:VisualElement name="MainWrapper" class="dashboard-wrapper">
        <ui:VisualElement name="SlidingContainer" class="sliding-container">
            
            <!-- CHANGED TO SCROLLVIEW -->
            <ui:ScrollView name="Page_Instructions" class="page-panel" mode="Vertical">
                <ui:VisualElement class="table-container">
                    <ui:VisualElement class="table-row">
                        <ui:Label text="Step Type" class="header-cell w-col-1"/>
                        <ui:Label text="Test" class="header-cell w-col-2"/>
                        <ui:Label text="Procedure" class="header-cell w-col-3"/>
                        <ui:Label text="Visual Info" class="header-cell w-col-4 no-right-border"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="table-row">
                        <ui:Label text="Preliminary Tests" class="body-cell center-text w-col-1"/>
                        <ui:VisualElement class="v-container flex-grow">
                            <ui:VisualElement class="sub-row">
                                <ui:Label text="1. Dil. HCl" class="body-cell w-col-2"/>
                                <ui:Label text="Add dil. HCl to Lead(II) nitrate." class="body-cell w-col-3"/>
                                <ui:Label text="White Precipitate Formed" class="body-cell w-col-4 no-right-border"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="sub-row no-bottom-border">
                                <ui:Label text="2. KI Sol." class="body-cell center-text w-col-2"/>
                                <ui:VisualElement class="v-container flex-grow">
                                    <ui:VisualElement class="sub-row">
                                        <ui:Label text="Add KI solution." class="body-cell w-col-3"/>
                                        <ui:Label text="Golden Yellow Ppt Formed" class="body-cell w-col-4 no-right-border"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="sub-row">
                                        <ui:Label text="Add water and boil." class="body-cell w-col-3"/>
                                        <ui:Label text="Precipitate Dissolved" class="body-cell w-col-4 no-right-border"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="sub-row no-bottom-border">
                                        <ui:Label text="Cool under tap water." class="body-cell w-col-3"/>
                                        <ui:Label text="Shimmering Crystals" class="body-cell w-col-4 no-right-border"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="table-row no-bottom-border">
                        <ui:Label text="Confirmatory Tests" class="body-cell center-text w-col-1"/>
                        <ui:VisualElement class="v-container flex-grow">
                            <ui:VisualElement class="sub-row">
                                <ui:Label text="1. NaOH" class="body-cell center-text w-col-2"/>
                                <ui:VisualElement class="v-container flex-grow">
                                    <ui:VisualElement class="sub-row">
                                        <ui:Label text="Add NaOH solution." class="body-cell w-col-3"/>
                                        <ui:Label text="White Precipitate Formed" class="body-cell w-col-4 no-right-border"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="sub-row no-bottom-border">
                                        <ui:Label text="Add excess NaOH." class="body-cell w-col-3"/>
                                        <ui:Label text="Precipitate Dissolved" class="body-cell w-col-4 no-right-border"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="sub-row no-bottom-border">
                                <ui:Label text="2. K2CrO4" class="body-cell w-col-2"/>
                                <ui:Label text="Add K2CrO4." class="body-cell w-col-3"/>
                                <ui:Label text="Yellow Precipitate Formed" class="body-cell w-col-4 no-right-border"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Swipe Left for Reaction Data ➔" class="swipe-hint"/>
            </ui:ScrollView>
            
            <!-- CHANGED TO SCROLLVIEW -->
            <ui:ScrollView name="Page_Reaction" class="page-panel" mode="Vertical">
                <ui:Label name="ReactionTitle" text="Waiting for Reagent..." class="header-title"/>
                <ui:Label name="ReactionWhy" text="Select a reagent to see its diagnostic principles." class="body-text"/>
                <ui:Label name="ReactionChemistry" text="" class="body-text"/>
                <ui:Label name="ReactionEquation" text="" class="equation-text"/>
                <ui:Label text="⬅ Swipe Right for Instructions" class="swipe-hint"/>
            </ui:ScrollView>
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>