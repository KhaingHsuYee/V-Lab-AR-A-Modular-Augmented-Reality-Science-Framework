  elementName: Iodine
  symbol: I
  atomicNumber: 53
  atomicWeight: 126.90447
  category: diatomic nonmetal
  protons: 53
  neutrons: 74
  electronShells: 0200000008000000120000001200000007000000
  electronConfiguration: 1s2 2s2 2p6 3s2 3p6 4s2 3d10 4p6 5s2 4d10 5p5
