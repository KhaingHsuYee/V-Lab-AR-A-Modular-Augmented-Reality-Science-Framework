  m_Name: Mercury
  m_EditorClassIdentifier: Assembly-CSharp::ElementData_Periodic
  elementName: Mercury
  symbol: Hg
  atomicNumber: 80
  atomicWeight: 200.5923
  category: transition metal
  protons: 80
  neutrons: 121
  electronShells: 020000000800000012000000200000001200000002000000
  electronConfiguration: 1s2 2s2 2p6 3s2 3p6 4s2 3d10 4p6 5s2 4d10 5p6 6s2 4f14 5d10
