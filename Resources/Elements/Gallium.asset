  m_Name: Gallium
  m_EditorClassIdentifier: Assembly-CSharp::ElementData_Periodic
  elementName: Gallium
  symbol: Ga
  atomicNumber: 31
  atomicWeight: 69.7231
  category: post-transition metal
  protons: 31
  neutrons: 39
  electronShells: 02000000080000001200000003000000
  electronConfiguration: 1s2 2s2 2p6 3s2 3p6 4s2 3d10 4p1
