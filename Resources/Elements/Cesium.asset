  elementName: Cesium
  symbol: Cs
  atomicNumber: 55
  atomicWeight: 132.90546
  category: alkali metal
  protons: 55
  neutrons: 78
  electronShells: 020000000800000012000000120000000800000001000000
  electronConfiguration: 1s2 2s2 2p6 3s2 3p6 4s2 3d10 4p6 5s2 4d10 5p6 6s1
