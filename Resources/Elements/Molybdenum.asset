  m_Name: Molybdenum
  m_EditorClassIdentifier: Assembly-CSharp::ElementData_Periodic
  elementName: Molybdenum
  symbol: Mo
  atomicNumber: 42
  atomicWeight: 95.951
  category: transition metal
  protons: 42
  neutrons: 54
  electronShells: 0200000008000000120000000d00000001000000
  electronConfiguration: 1s2 2s2 2p6 3s2 3p6 4s2 3d10 4p6 5s1 4d5
